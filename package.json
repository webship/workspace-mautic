{
  "name": "@webship.co/workspace-mautic",
  "version": "1.0.0",
  "description": "Mautic for Webship Workspace: the builder (`cmd-mautic-project.sh`, a site of the open-source marketing automation platform from its release package, installed with its own command-line installer, served by Apache in containers with a mail catcher and its scheduled tasks, with optional sample content) and the console tool in every sites folder, the default accounts and their roles, the Mautic step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-mautic.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "mautic",
    "label": "Mautic",
    "summary": "A builder for Mautic marketing automation sites (from the release package, with sample content), and its console tool",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-mautic-project.sh",
        "commands/cmd-tools-mautic-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-mautic.sh"
      ],
      "args": [
        "scripts/args/arg-mautic.sh",
        "scripts/args/arg-mautic-cli.sh"
      ],
      "machine": [
        "scripts/mautic-site.php",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/mautic-site-builder.md",
        "ai/agents/mautic-tester.md"
      ],
      "skills": [
        "ai/skills/mautic-scenarios"
      ],
      "commands": [
        "ai/commands/mautic-test.md"
      ],
      "prompts": [
        "ai/prompts/mautic-build-and-test.md",
        "ai/prompts/mautic-scenarios-for-an-area.md"
      ]
    },
    "features": [
      "features/mautic.feature",
      "features/mautic-runtimes.feature"
    ],
    "featuresSite": "cmd-mautic-project.sh ci-mautic --install --add-users --runtime docker"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
